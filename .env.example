# Copy this file to .env and fill in the values
FLASK_SECRET_KEY=change-me
DASHBOARD_SECRET_KEY=change-me-dashboard
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5003
FIREBASE_CREDENTIALS_PATH=Models/serviceAccountKey.json
APP_PORT=5000
BLOCKCHAIN_SERVICE_PORT=5001
PII_BRIDGE_PORT=5002
PII_DASHBOARD_PORT=5003
BLOCKCHAIN_SERVICE_URL=http://localhost:5001
PII_BRIDGE_URL=http://localhost:5002
SCRIPT_SERVICE_URL=http://localhost:5000
STACKS_API_BASE=https://api.testnet.hiro.so
STACKS_NETWORK=testnet
# CONTRACT_NAME can be either tokenization-system or pii-storage-system
CONTRACT_ADDRESS=
CONTRACT_NAME=pii-storage-system
TX_POLL_INTERVAL=10
TX_POLL_MAX_INTERVAL=60
TX_POLL_BACKOFF_FACTOR=1.5
MAX_CONTENT_LENGTH=52428800
